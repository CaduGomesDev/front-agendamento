# ============================================================
#  FRONTEND — variáveis de ambiente (modelo)
#  Copie este arquivo para ".env" e ajuste os valores.
#  NÃO commite o .env real.
# ============================================================

# URL base da API REST do backend. OBRIGATÓRIA.
# Local:    http://localhost:3333/api
# Produção: defina esta variável no painel da Vercel apontando para a URL do Render
#           (ex.: https://seu-backend.onrender.com/api)
VITE_API_URL="http://localhost:3333/api"

# Client ID do Google para o login social ("Entrar com Google").
# Precisa ser o MESMO valor de GOOGLE_CLIENT_ID no backend. O domínio do front
# (produção e localhost:5173) deve estar em "Authorized JavaScript origins" do
# OAuth Client (tipo Web) no Google Cloud. Em produção, defina no painel da Vercel.
# VITE_GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
